{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules-export/1",
  "title": "rules-export/1",
  "description": "Every document rules.nvim hands to a machine (read only). One of the kinds below, told apart by `kind`. A reader ignores fields it does not know: inside one version the contract only grows. The golden files next to this schema are the documents the engine writes.",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/list" },
    { "$ref": "#/$defs/rule" },
    { "$ref": "#/$defs/next_id" },
    { "$ref": "#/$defs/sources" },
    { "$ref": "#/$defs/waivers" },
    { "$ref": "#/$defs/rulesets" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "head": {
      "type": "object",
      "required": ["schema", "plugin", "kind", "generated_at", "source", "engine"],
      "properties": {
        "schema": { "const": 1 },
        "plugin": { "const": "rules.nvim" },
        "kind": { "type": "string" },
        "generated_at": { "type": "string", "description": "UTC, YYYY-MM-DDTHH:MM:SSZ; not part of the digest" },
        "source": {
          "type": "object",
          "required": ["id"],
          "properties": { "id": { "type": "string", "description": "the last part of the first ruleset path; never a path of this machine" } }
        },
        "engine": {
          "type": "object",
          "required": ["version", "git", "nvim"],
          "properties": {
            "version": { "type": "string" },
            "git": { "type": "string" },
            "nvim": { "type": "string" }
          }
        },
        "rev": { "type": "string", "pattern": "^rev:[0-9a-f]+$", "description": "what the source looked like; present on documents that come from a scan" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{16}$", "description": "hash of the document without generated_at and engine" }
      }
    },
    "severity": { "enum": ["critical", "recommended", "nice-to-have"] },
    "rule_summary": {
      "type": "object",
      "required": ["id", "family", "severity", "title", "section", "source", "line", "has_check", "has_agent", "editable", "etag", "etag_scope"],
      "properties": {
        "id": { "type": "string" },
        "family": { "type": "string", "description": "the id up to the first '-' when only letters come before it" },
        "severity": { "$ref": "#/$defs/severity" },
        "title": { "type": "string" },
        "section": { "type": "string" },
        "source": { "type": "string", "description": "<ruleset folder>/<path inside it>, with /" },
        "line": { "type": "integer", "minimum": 1 },
        "has_check": { "type": "boolean" },
        "check_type": { "type": "string" },
        "has_agent": { "type": "boolean" },
        "editable": { "type": "boolean", "description": "false when the check holds a Lua function: it cannot be written as data and a client must not write it back" },
        "etag": { "type": "string", "pattern": "^sha256:[0-9a-f]{16}$", "description": "the version of the FILE the rule lives in" },
        "etag_scope": { "enum": ["rule", "file"], "description": "rule: the rule is a file of its own (one file per rule), the form rules-ops/1 writes; file: a document that holds rules, any change to it changes every etag in it, and rules-ops/1 does not write it" }
      }
    },
    "retired": {
      "type": "object",
      "required": ["id", "family", "source"],
      "properties": {
        "id": { "type": "string" },
        "family": { "type": "string" },
        "source": { "type": "string" },
        "replaced_by": { "type": "string" },
        "retired": { "type": "string", "description": "the date it was retired, YYYY-MM-DD" },
        "reason": { "type": "string" }
      }
    },
    "source_file": {
      "type": "object",
      "required": ["path", "rules", "etag"],
      "properties": {
        "path": { "type": "string" },
        "rules": { "type": "integer", "minimum": 1 },
        "etag": { "type": "string" }
      }
    },
    "hello": {
      "title": "rules.hello: what this engine is and can do. Reads no rule.",
      "allOf": [
        { "$ref": "#/$defs/head" },
        {
          "type": "object",
          "required": ["kind", "schemas", "capabilities", "limits", "enums", "read_only"],
          "properties": {
            "kind": { "const": "rules.hello" },
            "schemas": { "type": "array", "items": { "type": "integer" } },
            "capabilities": { "type": "array", "items": { "type": "string" } },
            "limits": {
              "type": "object",
              "properties": {
                "list_items": { "type": "integer" },
                "request_bytes": { "type": "integer" },
                "doc_bytes": { "type": "integer" }
              }
            },
            "enums": { "type": "object", "properties": { "severity": { "type": "array", "items": { "type": "string" } } } },
            "read_only": { "type": "boolean", "description": "false when the engine has the write door (`ops`)" },
            "ops": { "type": "array", "items": { "type": "string" }, "description": "the operations of rules-ops/1 the engine knows" }
          }
        }
      ]
    },
    "snapshot": {
      "title": "rules.snapshot: families with counters, every rule, the sources, the gates, what failed to load.",
      "allOf": [
        { "$ref": "#/$defs/head" },
        {
          "type": "object",
          "required": ["kind", "counts", "families", "rules", "sources", "gates", "load_errors", "rev", "digest"],
          "properties": {
            "kind": { "const": "rules.snapshot" },
            "counts": {
              "type": "object",
              "properties": { "rules": { "type": "integer" }, "families": { "type": "integer" }, "files": { "type": "integer" } }
            },
            "families": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "family": { "type": "string" },
                  "count": { "type": "integer" },
                  "critical": { "type": "integer" },
                  "recommended": { "type": "integer" },
                  "nice_to_have": { "type": "integer" },
                  "with_check": { "type": "integer" }
                }
              }
            },
            "rules": { "type": "array", "items": { "$ref": "#/$defs/rule_summary" } },
            "sources": { "type": "array", "items": { "$ref": "#/$defs/source_file" } },
            "gates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "families": { "type": "array", "items": { "type": "string" } },
                  "rules": { "type": "integer" },
                  "unknown": { "type": "array", "items": { "type": "string" }, "description": "families of the gate that match no loaded rule" }
                }
              }
            },
            "retired": { "type": "array", "items": { "$ref": "#/$defs/retired" } },
            "load_errors": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "list": {
      "title": "rules.list: a page of rules, in id order.",
      "allOf": [
        { "$ref": "#/$defs/head" },
        {
          "type": "object",
          "required": ["kind", "total", "offset", "limit", "items", "rev", "digest"],
          "properties": {
            "kind": { "const": "rules.list" },
            "total": { "type": "integer" },
            "offset": { "type": "integer" },
            "limit": { "type": "integer" },
            "items": { "type": "array", "items": { "$ref": "#/$defs/rule_summary" } }
          }
        }
      ]
    },
    "rule": {
      "title": "rules.rule: one rule with its text, its check and the etag of its file.",
      "allOf": [
        { "$ref": "#/$defs/head" },
        {
          "type": "object",
          "required": ["kind", "rule", "rev", "digest"],
          "properties": {
            "kind": { "const": "rules.rule" },
            "rule": {
              "allOf": [
                { "$ref": "#/$defs/rule_summary" },
                {
                  "type": "object",
                  "required": ["text"],
                  "properties": {
                    "text": { "type": "string" },
                    "check": { "type": "object", "description": "the check as data, without functions" },
                    "agent": { "type": "object" }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "next_id": {
      "title": "rules.next_id: the next free id of a family, or of every family.",
      "allOf": [
        { "$ref": "#/$defs/head" },
        {
          "type": "object",
          "required": ["kind", "basis", "items", "rev", "digest"],
          "properties": {
            "kind": { "const": "rules.next_id" },
            "basis": { "type": "array", "items": { "enum": ["loaded", "retired"] }, "description": "whose ids were looked at; `retired` joins when rules-ops/1 defines retiring" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "family": { "type": "string" },
                  "highest": { "type": "integer" },
                  "count": { "type": "integer" },
                  "next": { "type": "string", "maxLength": 100, "description": "absent where the next id would be longer than an id may be (100 bytes)" }
                }
              }
            }
          }
        }
      ]
    },
    "sources": {
      "title": "rules.sources: the files the rules come from, with the etag of each.",
      "allOf": [
        { "$ref": "#/$defs/head" },
        {
          "type": "object",
          "required": ["kind", "items", "load_errors", "rev", "digest"],
          "properties": {
            "kind": { "const": "rules.sources" },
            "items": { "type": "array", "items": { "$ref": "#/$defs/source_file" } },
            "load_errors": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "rulesets": {
      "title": "rules.rulesets: the rulesets that are loaded, and the ones in the archive of the vault.",
      "allOf": [
        { "$ref": "#/$defs/head" },
        {
          "type": "object",
          "required": ["kind", "items", "archived", "rev", "digest"],
          "properties": {
            "kind": { "const": "rules.rulesets" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "folder", "in_vault"],
                "properties": {
                  "name": { "type": "string", "description": "how the engine calls the ruleset in a source (the last folder, or the folder above it too when two share a name)" },
                  "folder": { "type": "string", "description": "the folder name; what create_ruleset, archive_ruleset and restore_ruleset take" },
                  "in_vault": { "type": "boolean", "description": "a folder under rulesets/ of the vault: only those can be archived" }
                }
              }
            },
            "archived": { "type": "array", "items": { "type": "string" }, "description": "folder names under archive/rulesets/ of the vault; restore_ruleset brings one back" }
          }
        }
      ]
    },
    "waiver": {
      "type": "object",
      "required": ["id", "reason", "expired", "known"],
      "properties": {
        "id": { "type": "string" },
        "reason": { "type": "string", "maxLength": 500 },
        "expires": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "a real calendar date; the waiver is valid through that day. Absent: no expiry" },
        "paths": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string" }, "description": "files, folders or globs relative to the project root, with /. Absent: every path" },
        "expired": { "type": "boolean", "description": "expires is before `today` of the document: the waiver suppresses nothing" },
        "known": { "type": "boolean", "description": "a loaded rule has this id; false: the waiver protects nothing (the rule was retired or renamed)" }
      }
    },
    "waivers": {
      "title": "rules.waivers: the waivers of a project (its .rules-waivers.json), each with whether it is expired and whether its rule is loaded.",
      "allOf": [
        { "$ref": "#/$defs/head" },
        {
          "type": "object",
          "required": ["kind", "today", "etag", "exists", "counts", "items", "rev", "digest"],
          "properties": {
            "kind": { "const": "rules.waivers" },
            "today": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "the day expiry was judged against (the day of the machine, or the `today` the engine was given)" },
            "etag": { "type": "string", "pattern": "^sha256:[0-9a-f]{16}$", "description": "the version of the waivers FILE; a project without one has the etag of an empty file. What `if_match` of waive, renew and remove compares against" },
            "exists": { "type": "boolean", "description": "false when the project has no waivers file" },
            "counts": {
              "type": "object",
              "properties": { "total": { "type": "integer" }, "expired": { "type": "integer" }, "unknown": { "type": "integer" } }
            },
            "items": { "type": "array", "items": { "$ref": "#/$defs/waiver" }, "description": "in id order" }
          }
        }
      ]
    },
    "result": {
      "title": "rules.result: the answer of the write door (rules-ops/1), one entry per operation.",
      "allOf": [
        { "$ref": "#/$defs/head" },
        {
          "type": "object",
          "required": ["kind", "ok", "dry_run", "results", "digest"],
          "properties": {
            "kind": { "const": "rules.result" },
            "client_op_id": { "type": "string" },
            "dry_run": { "type": "boolean" },
            "ok": { "type": "boolean", "description": "true only if every entry is" },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["n", "op", "ok", "changed_ids"],
                "properties": {
                  "n": { "type": "integer", "minimum": 1 },
                  "op": { "enum": ["new", "set", "retire", "reinstate", "move", "waive", "renew", "remove", "create_ruleset", "archive_ruleset", "restore_ruleset"] },
                  "ok": { "type": "boolean" },
                  "id": { "type": "string" },
                  "ruleset": { "type": "string", "description": "create_ruleset, archive_ruleset, restore_ruleset: the folder name of the ruleset (an entry of those operations has no id)" },
                  "outcome": { "type": "string", "description": "created, changed, unchanged, retired, reinstated, moved, waived, renewed, removed, archived, restored, would_*, conflict, failed" },
                  "etag_before": { "type": "string" },
                  "etag_after": { "type": "string" },
                  "changed_ids": { "type": "array", "items": { "type": "string" } },
                  "before": { "type": "object", "description": "set: the values the patch replaced, in the shape of a patch; renew: the expiry (and reason) it replaced, as the fields of a renew; remove: the waiver that was dropped (reason, expires, paths)" },
                  "inverse": { "type": "object", "description": "the operation that undoes this one" },
                  "placed": { "type": "object", "properties": { "layout": { "type": "string" } } },
                  "warnings": { "type": "array", "items": { "type": "string" }, "description": "things to know that did not stop the operation; absent when there are none. new: the rules-vault is behind its upstream, so another machine may make the same id. waive, renew: expires is before today, so the waiver is expired from the start" },
                  "diff": { "type": "object", "description": "dry run of set, waive, renew, remove: the file text before and after" },
                  "catalog": { "type": "object", "description": "the documents made again after the write", "properties": { "written": { "type": "integer" }, "errors": { "type": "integer" } } },
                  "error": {
                    "type": "object",
                    "properties": {
                      "code": { "type": "string", "description": "invalid_argument, not_found, conflict (details: expected, actual), locked, forbidden (the waivers file is a link), payload_too_large, io, rollback_incomplete (details: not_restored), internal" },
                      "message": { "type": "string" },
                      "retryable": { "type": "boolean" },
                      "details": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "error": {
      "title": "rules.error: what went wrong, in a code that is stable.",
      "allOf": [
        { "$ref": "#/$defs/head" },
        {
          "type": "object",
          "required": ["kind", "code", "message", "retryable"],
          "properties": {
            "kind": { "const": "rules.error" },
            "code": { "enum": ["invalid_argument", "not_found", "unsupported_schema", "payload_too_large", "io", "internal"] },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
